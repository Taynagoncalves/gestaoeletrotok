PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gestaoeletrotok

# Necessario para provedores gerenciados como o Aiven, que exigem SSL.
# DB_SSL_CA_PATH deve apontar para o certificado ca.pem baixado do painel.
DB_SSL=false
DB_SSL_CA_PATH=

# Chave usada para criptografar credenciais fiscais (token do provedor de
# NF-e, senha do certificado digital, e o certificado em si) antes de
# salvar no banco. Gere uma string aleatoria longa e NUNCA a compartilhe
# ou troque depois de ja ter dados salvos (perderia acesso a eles).
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
